{
	"$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 3,
		"lineWidth": 128,
		"lineEnding": "lf"
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"complexity": {
				"noForEach": "warn"
			},
			"correctness": {
				"noUnusedVariables": "warn",
				"noUnusedImports": "error",
				"noUnusedFunctionParameters": "error"
			},
			"style": {
				"useThrowNewError": "error",
				"noNestedTernary": "error",
				"noExportedImports": "error",
				"useNamingConvention": "info",
				"noParameterAssign": "error"
			},
			"suspicious": {
				"noConsole": "off",
				"useAwait": "error",
				"noEmptyBlockStatements": "error",
				"noTemplateCurlyInString": "error",
				"noUnknownAtRules": "off"
			},
			"nursery": {
				"useExplicitType": "off",
				"useSortedClasses": "error",
				"noSecrets": "off"
			}
		},
		"domains": {
			"react": "recommended"
		}
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "double",
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"jsxQuoteStyle": "double",
			"quoteProperties": "asNeeded",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
